{
  "name": "personal-finances-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm --prefix ../frontend run build && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "setup:dev-vars": "node scripts/write-dev-vars.mjs",
    "secret:push": "node scripts/print-service-account.mjs | wrangler secret put FIREBASE_SERVICE_ACCOUNT"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  }
}
